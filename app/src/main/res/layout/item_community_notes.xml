<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/text_note_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.AppCompat.Caption"
        android:text="@string/user_placeholder" />

    <TextView
        android:id="@+id/text_note_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/note_text_placeholder" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/button_upvote"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/arrow_up_float"
            android:contentDescription="@string/upvote"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/text_upvotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vote_count_zero" />

        <ImageView
            android:id="@+id/button_downvote"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/arrow_down_float"
            android:contentDescription="@string/downvote"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/text_downvotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vote_count_zero" />

    </LinearLayout>

</LinearLayout>