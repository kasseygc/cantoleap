<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_vocabulary">

    <fragment
        android:id="@+id/navigation_vocabulary"
        android:name="com.example.project.ui.vocabulary.VocabularyFragment"
        android:label="@string/title_vocabulary"
        tools:layout="@layout/fragment_vocabulary">

        <action
            android:id="@+id/action_navigation_vocabulary_to_navigation_learning"
            app:destination="@id/navigation_learning" />
    </fragment>

    <fragment
        android:id="@+id/navigation_learning"
        android:name="com.example.project.ui.learning.LearningFragment"
        android:label="@string/title_learning"
        tools:layout="@layout/fragment_learning">

        <argument
            android:name="category"
            app:argType="string"
            android:defaultValue="greetings" />

        <action
            android:id="@+id/action_navigation_learning_to_navigation_vocabulary"
            app:destination="@id/navigation_vocabulary"
            app:popUpTo="@id/navigation_vocabulary"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_practice"
        android:name="com.example.project.ui.practice.PracticeFragment"
        android:label="@string/title_practice"
        tools:layout="@layout/fragment_practice">

        <argument
            android:name="category"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true" />

        <action
            android:id="@+id/action_navigation_practice_to_navigation_vocabulary"
            app:destination="@id/navigation_vocabulary"
            app:popUpTo="@id/navigation_vocabulary"
            app:popUpToInclusive="true" />
    </fragment>

    <dialog
        android:id="@+id/navigation_notes_bottom_sheet"
        android:name="com.example.project.ui.notes.NotesBottomSheet"
        android:label="Notes">

        <argument
            android:name="vocabulary_id"
            app:argType="string" />
    </dialog>
</navigation>